# Local Ollama is the default provider. Pull both models before starting:
#   ollama pull qwen3.5:9b
#   ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3.5:9b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_TIMEOUT_MS=30000

# Optional OpenAI provider. This key is read only by server-side API routes.
# Never expose it through a NEXT_PUBLIC_ variable.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra

# Retrieval/generation tuning.
CHEF_TOP_K=5
CHEF_PROVIDER_TIMEOUT_MS=120000

# Protect catalog imports outside local development. Requests from localhost
# may omit this; every non-local request must send it as a Bearer token.
CATALOG_ADMIN_TOKEN=
