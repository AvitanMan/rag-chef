# Local Ollama is the default provider. Pull both models before starting:
# Deployed Chef uses generation/verifier settings; Catalog uses embedding settings.
# The application gateway makes no model calls.
# Copy to .env.local for development. For pnpm start, use .dev.vars instead.
# Both local files are ignored by Git. Leave secret values out of this template.
#   ollama pull qwen3.5:9b
#   ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3.5:9b
# Also used for local answer verification when generation uses OpenAI.
# Keep Ollama running for verified recipe questions; no paid verifier is used.
OLLAMA_EMBED_MODEL=nomic-embed-text
# Keep this non-secret model name identical on gateway, Catalog and Chef.
# The gateway selects a retrieval model but does not call the model provider.
OLLAMA_EMBED_TIMEOUT_MS=30000
# Catalog job provider calls are capped at 30000ms and persist completed batches.

# Optional OpenAI provider. Configure this secret on the private Chef Worker.
# The gateway and Catalog Worker do not need the generation key.
# Never expose it through a NEXT_PUBLIC_ variable.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra

# Private Chef retrieval/generation tuning.
CHEF_TOP_K=5
CHEF_PROVIDER_TIMEOUT_MS=120000
# Individual generation: 5000–300000ms; complete Chef request ceiling: 20min.
# Model connection check ceiling: 15sec. Service calls are not replayed.

# Shared D1 admission policy. Keep these settings identical on all three Workers.
# Provider concurrency is shared by Chef and Catalog, including background jobs.
# Positive integers only (provider range 1–100); zero is invalid, not unlimited.
MODEL_OLLAMA_CONCURRENCY=2
MODEL_OPENAI_CONCURRENCY=4
# Hosted limits count admitted Chef answer requests per household, including
# deterministic answers. These are fixed UTC minute/day windows, not token bills.
CHEF_HOSTED_REQUESTS_PER_MINUTE=60
CHEF_HOSTED_REQUESTS_PER_DAY=1000
# Blank disables the corresponding standalone request window only.
CHEF_LOCAL_REQUESTS_PER_MINUTE=
CHEF_LOCAL_REQUESTS_PER_DAY=
# Use the same non-secret immutable release label on all deployed Workers.
# Allowed: letters, digits, dot, underscore and hyphen, at most 80 characters.
SERVICE_RELEASE=development

# Standalone catalog maintenance token for non-loopback requests.
# Hosted mode uses signed-in platform administrator access instead.
CATALOG_ADMIN_TOKEN=

# Optional maintenance-command target; export in your shell when overriding.
RECIPES_APP_URL=http://localhost:3000
# Optional stable submission key when explicitly retrying recipes:embed after
# a lost acceptance response. Use a new value for a new operation.
# CATALOG_REQUEST_ID=

# Optional hosted households. Local mode remains the default.
# Use a separate hosted database; do not copy personal local state to it.
RAG_CHEF_HOSTED=0
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Verified accounts allowed to create households; separate catalog operators.
HOUSEHOLD_OWNER_EMAILS=
PLATFORM_ADMIN_EMAILS=
# Exact source IDs explicitly approved for hosted distribution.
# Empty permits only the original rag-chef-starters source.
HOSTED_RECIPE_SOURCE_IDS=
# Hosted AI connections are not part of this auth/household integration.
# Hosted requests never use the local/server model credentials above.

# All three Workers use the same DB and matching hosted/source policy settings.
# Configure CHEF / CATALOG / CATALOG_TASKS bindings in Wrangler, not public vars.
# Independently deployed Workers need their own settings; neither private Worker
# exposes a public URL. Keep enable_request_signal in all compatibility flags.
# Apply migrations through 0009_catalog_job_recipe_receipts.sql and follow docs/service-rollout.md before
# routing traffic to a new release. Readiness never invokes a model provider.
