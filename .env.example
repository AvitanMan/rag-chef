# Local Ollama is the default provider. Pull both models before starting:
# Copy to .env.local for development. For pnpm start, use .dev.vars instead.
# Both local files are ignored by Git. Leave secret values out of this template.
#   ollama pull qwen3.5:9b
#   ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3.5:9b
# Ollama answers use the local model for verification. OpenAI answers use
# a separate verification request through the same OpenAI connection.
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_TIMEOUT_MS=30000

# Optional OpenAI provider. This key is read only by server-side API routes.
# Never expose it through a NEXT_PUBLIC_ variable.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra

# Retrieval/generation tuning.
CHEF_TOP_K=5
CHEF_PROVIDER_TIMEOUT_MS=120000

# Protect catalog imports outside local development. Requests from localhost
# may omit this; every non-local request must send it as a Bearer token.
CATALOG_ADMIN_TOKEN=

# Optional maintenance-command target; export in your shell when overriding.
RECIPES_APP_URL=http://localhost:3000

# Hosted family beta: leave disabled for standalone use. See docs/hosted-beta.md.
RAG_CHEF_HOSTED=0
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
HOUSEHOLD_OWNER_EMAILS=
PLATFORM_ADMIN_EMAILS=
# Optional exact source IDs reviewed for hosted distribution; originals are enabled by default.
# Leave empty for only rag-chef-starters. No wildcards or automatic local-catalog approval.
HOSTED_RECIPE_SOURCE_IDS=
AI_CREDENTIALS_KEY_VERSION=v1
# Base64-encoded 32-byte key; keep in Worker secrets, never source control.
AI_CREDENTIALS_ENCRYPTION_KEY_V1=
