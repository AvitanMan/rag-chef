{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rag-chef-catalog",
  "main": "./worker/catalog.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [{
    "binding": "DB",
    "database_name": "site-creator-d1",
    "database_id": "00000000-0000-4000-8000-000000000000",
    "migrations_dir": "drizzle"
  }],
  "queues": {
    "producers": [{ "binding": "CATALOG_TASKS", "queue": "rag-chef-catalog-jobs" }],
    "consumers": [{ "queue": "rag-chef-catalog-jobs", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 5 }]
  },
  "triggers": { "crons": ["* * * * *"] }
}
